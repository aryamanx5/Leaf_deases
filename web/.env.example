# Copy to web/.env.local. All optional.
# API origin when the site is not served behind the same host (default: same origin, /api proxied by Vite).
VITE_API_BASE=
# "Go to the deployed app" button in the closing section; hidden when empty.
VITE_DEPLOYED_APP_URL=
# Repository link in the footer; hidden when empty.
VITE_GITHUB_URL=
